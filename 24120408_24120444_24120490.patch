     return -1;
   return getsysinfo(addr);
 }
+
+uint64
+sys_pgaccess(void)
+{
+  uint64 addr, result;
+  int n;
+  uint mask = 0;
+  pte_t *ptes[32];
+  struct proc *p = myproc();
+
+  argaddr(0, &addr);
+  argint(1, &n);
+  argaddr(2, &result);
+  addr = PGROUNDDOWN(addr);
+  if(n < 0 || n > 32 || addr >= MAXVA ||
+     (uint64)n > (MAXVA - addr) / PGSIZE)
+    return -1;
+
+  for(int i = 0; i < n; i++){
+    ptes[i] = walk(p->pagetable, addr + i * PGSIZE, 0);
+    if(ptes[i] == 0 || (*ptes[i] & (PTE_V | PTE_U)) != (PTE_V | PTE_U))
+      return -1;
+    if(*ptes[i] & PTE_A)
+      mask |= 1U << i;
+  }
+
+  // Keep access bits intact if copying the result fails.
+  if(copyout(p->pagetable, result, (char *)&mask, sizeof(mask)) < 0)
+    return -1;
+  // userret flushes the TLB before user mode resumes.
+  for(int i = 0; i < n; i++)
+    *ptes[i] &= ~PTE_A;
+  return 0;
+}
diff --git a/kernel/vmprint.c b/kernel/vmprint.c
new file mode 100644
index 0000000000000000000000000000000000000000..420b80a62e60dbc5b4f1a349e917b8ad60ff9725
--- /dev/null
+++ b/kernel/vmprint.c
@@ -0,0 +1,32 @@
+#include "types.h"
+#include "param.h"
+#include "memlayout.h"
+#include "riscv.h"
+#include "defs.h"
+
+// Print the valid PTEs of one page-table page and descend into
+// lower-level tables. depth is 1 for the root, 3 for leaf level.
+static void vmprint_level(pagetable_t pagetable, int depth){
+  for (int i=0;i<512;i++){
+    pte_t pte=pagetable[i];
+
+    // Skip invalid PTEs.
+    if((pte & PTE_V) == 0)
+      continue;
+
+    for(int j=0;j<depth;j++){
+      printf(" ..");
+    }
+    printf("%d: pte %p pa %p\n", i, (void *)pte, (void *)PTE2PA(pte));
+
+    // A valid PTE with R, W and X all clear points to a lower-level table.
+    if((pte & (PTE_R|PTE_W|PTE_X)) == 0)
+      vmprint_level((pagetable_t)PTE2PA(pte), depth + 1);
+  }
+}
+
+// Print a page table: its address, then every valid PTE.
+void vmprint(pagetable_t pagetable){
+  printf("page table %p\n", pagetable);
+  vmprint_level(pagetable, 1);
+}
